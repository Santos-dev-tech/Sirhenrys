<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sir Henry's Limited &mdash; Crafted for the Distinguished Gentleman</title>
<meta name="description" content="Premium menswear and bespoke tailoring in Nairobi since 1967. Suits, shirts, and made-to-measure with free alterations for life.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 fill=%27%23151515%27/%3E%3Ctext x=%2716%27 y=%2722%27 font-family=%27Georgia,serif%27 font-size=%2716%27 font-weight=%27700%27 fill=%27%23846144%27 text-anchor=%27middle%27%3ESH%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="assets/css/site.css">
</head>
<body>
<div id="progress"></div>
<div id="veil"></div>

<div class="announce">
  <ul>
    <li>Bespoke tailoring, est. 1967</li><li>Complimentary alterations on all suits, for life</li>
    <li>Free delivery over KSh 20,000</li><li>M-Pesa accepted</li><li>Four stores across Kenya</li>
    <li>Bespoke tailoring, est. 1967</li><li>Complimentary alterations on all suits, for life</li>
    <li>Free delivery over KSh 20,000</li><li>M-Pesa accepted</li><li>Four stores across Kenya</li>
  </ul>
</div>

<header class="hdr">
  <div class="wrap hdr-in">
    <nav class="nav">
      <button class="iconbtn burger" data-menu aria-label="Menu">
        <svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
      <div class="navitem"><a href="#/shop?cat=suits">Suits</a>
        <div class="mega">
          <div><h5>By cut</h5><ul>
            <li><a href="#/shop?cat=suits&sub=two-piece">Two Piece Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=three-piece">Three Piece Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=double-breasted">Double Breasted</a></li>
            <li><a href="#/shop?cat=suits&sub=tuxedo">Tuxedo</a></li>
            <li><a href="#/shop?cat=suits&sub=blazers">Blazers</a></li></ul></div>
          <div><h5>By occasion</h5><ul>
            <li><a href="#/shop?cat=suits&sub=work">Work Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=prom">Prom Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=graduation">Graduation Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=wool">Wool Suits</a></li>
            <li><a href="#/shop?cat=suits&sub=linen">Linen Suits</a></li></ul></div>
          <figure><a href="#/bespoke"><img src="assets/img/ed-fabric.jpg" alt="">
            <figcaption>Made to Measure &rarr;</figcaption></a></figure>
        </div></div>
      <div class="navitem"><a href="#/shop?cat=shirts">Shirts</a>
        <div class="mega" style="grid-template-columns:1fr 220px;min-width:440px">
          <div><h5>Shirts</h5><ul>
            <li><a href="#/shop?cat=shirts&sub=formal">Formal Shirts</a></li>
            <li><a href="#/shop?cat=shirts&sub=patterned">Patterned</a></li>
            <li><a href="#/shop?cat=shirts&sub=evening">Evening Shirts</a></li></ul></div>
          <figure><a href="#/shop?cat=shirts"><img src="assets/img/cat-shirts.jpg" alt="">
            <figcaption>All shirts &rarr;</figcaption></a></figure>
        </div></div>
      <div class="navitem"><a href="#/shop?cat=casual">Casual</a>
        <div class="mega" style="grid-template-columns:1fr 220px;min-width:440px">
          <div><h5>Casual</h5><ul>
            <li><a href="#/shop?cat=casual&sub=polo">Polo Shirts</a></li>
            <li><a href="#/shop?cat=casual&sub=jackets">Coats &amp; Jackets</a></li>
            <li><a href="#/shop?cat=casual&sub=chinos">Chinos</a></li>
            <li><a href="#/shop?cat=casual&sub=smart-casual">Smart Casual</a></li></ul></div>
          <figure><a href="#/shop?cat=casual"><img src="assets/img/cat-casual.jpg" alt="">
            <figcaption>All casual &rarr;</figcaption></a></figure>
        </div></div>
      <a href="#/shop?cat=accessories">Accessories</a>
      <a href="#/bespoke">Made to Measure</a>
      <a href="#/wedding">Weddings</a>
      <a href="#/lookbook">Lookbook</a>
    </nav>

    <a class="brand" href="#/">SIR HENRY'S<small>Nairobi &middot; Est. 1967</small></a>

    <div class="hdr-act">
      <a class="iconbtn" href="#/search" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.3-4.3"/></svg></a>
      <a class="iconbtn" href="#/stores" aria-label="Stores">
        <svg viewBox="0 0 24 24"><path d="M12 21s7-5.4 7-11a7 7 0 10-14 0c0 5.6 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/></svg></a>
      <a class="iconbtn" href="#/wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 00-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 000-7.8z"/></svg></a>
      <a class="iconbtn" href="#/account" aria-label="Account">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0115 0"/></svg></a>
      <button class="iconbtn" data-opencart aria-label="Bag">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l1.2 13H4.8zM9 7V5.5a3 3 0 016 0V7"/></svg>
        <span class="badge" data-cartcount style="display:none">0</span></button>
    </div>
  </div>
</header>

<main id="app"></main>

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-top">
      <div class="ftr-brand">
        <b>SIR HENRY'S</b>
        <p>Premium menswear and bespoke tailoring on Kimathi Street, Nairobi, since 1967. Crafted for the distinguished gentleman.</p>
        <form class="sub" id="subForm">
          <input type="email" placeholder="Your email" required aria-label="Email">
          <button data-magnet="0.2">Join</button>
        </form>
      </div>
      <div><h4>Shop</h4><ul>
        <li><a href="#/shop?cat=suits">Suits</a></li><li><a href="#/shop?cat=shirts">Shirts</a></li>
        <li><a href="#/shop?cat=casual">Casual</a></li><li><a href="#/shop?cat=accessories">Accessories</a></li>
        <li><a href="#/shop?sort=sale">Sale</a></li></ul></div>
      <div><h4>Services</h4><ul>
        <li><a href="#/bespoke">Made to Measure</a></li><li><a href="#/wedding">Weddings &amp; Groups</a>
  <a href="#/corporate">Corporate &amp; Bulk</a></li>
        <li><a href="#/appointments">Book a Fitting</a></li>
        <li><a href="#/corporate">Corporate Service</a></li><li><a href="#/about">Charity Programme</a></li>
        <li><a href="#/contact">Careers</a></li></ul></div>
      <div><h4>Visit</h4><ul>
        <li><a href="#/stores">Our Stores</a></li><li><a href="#/about">About Us</a></li>
        <li><a href="#/contact">Contact</a></li><li><a href="admin.html">Staff Login</a></li></ul></div>
    </div>
    <div class="ftr-bot">
      <span>&copy; 2026 Sir Henry's Limited. Nairobi, Kenya. Tel (+254) 713 619786.</span>
      <div class="pays"><span>M-PESA</span><span>VISA</span><span>MASTERCARD</span><span>AMEX</span></div>
    </div>
  </div>
</footer>

<a class="wa" href="https://wa.me/254713619786" target="_blank" rel="noopener" aria-label="WhatsApp us">
  <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.8 14.2c-.2.7-1.2 1.3-1.9 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.4.5-.3.3c-.1.1-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2.1 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
</a>

<!-- cart drawer -->
<div class="scrim" id="scrim"></div>
<aside class="drawer" id="cartDrawer" aria-label="Shopping bag">
  <div class="drawer-hd"><b>Your bag</b><button class="x" data-close aria-label="Close">&times;</button></div>
  <div class="drawer-bd" id="cartBody" data-lenis-prevent></div>
  <div class="drawer-ft">
    <div class="tot"><span>Subtotal</span><b id="cartSub">KSh 0.00</b></div>
    <div class="tot"><span>Delivery</span><b id="cartShip">Free</b></div>
    <div class="tot big"><span>Total</span><b id="cartTot">KSh 0.00</b></div>
    <a class="btn wide" href="#/checkout" data-close style="margin-top:14px">Checkout</a>
    <a class="btn ghost wide" href="#/cart" data-close style="margin-top:8px">View bag</a>
    <a class="btn wa-btn wide" id="waOrder" style="margin-top:8px" target="_blank" rel="noopener" href="#">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2z"/></svg>
      Order on WhatsApp</a>
  </div>
</aside>

<!-- size finder -->
<aside class="drawer" id="fitModal" aria-label="Find my size">
  <div class="drawer-hd"><b>Find my size</b><button class="x" data-close aria-label="Close">&times;</button></div>
  <div class="drawer-bd" data-lenis-prevent>
    <p class="muted" style="font-size:13px">Two measurements and we will tell you where to start. Alterations are free, so we can take it from there in store.</p>
    <form id="fitForm">
      <div class="field"><label>Chest (cm)</label><input name="chest" type="number" min="80" max="140" value="100" required></div>
      <div class="field"><label>Height (cm)</label><input name="height" type="number" min="150" max="210" value="178" required></div>
      <div class="field"><label>Fit preference</label><select name="fit">
        <option>Slim</option><option>Regular</option><option>Relaxed</option></select></div>
      <button class="btn wide">Calculate my size</button>
    </form>
    <div id="fitOut" style="margin-top:26px"></div>
    <p class="muted" style="font-size:12px;margin-top:22px">Prefer to be measured properly?
      <a href="#/appointments" data-close style="color:var(--bronze);border-bottom:1px solid">Book a free fitting</a>.</p>
  </div>
</aside>

<!-- mobile nav -->
<nav class="mnav" id="mnav" data-lenis-prevent>
