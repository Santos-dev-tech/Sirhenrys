# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Firebase Admin credentials. A service account key is a root credential for the
# whole project - it bypasses firestore.rules entirely. Never commit one.
serviceAccount*.json
*-firebase-adminsdk-*.json
firebase-debug.log
.firebase/

# the deck generator pulls pptxgenjs; the .pptx is the deliverable, not its toolchain
pitch/node_modules/
pitch/package-lock.json
pitch/*.pdf
